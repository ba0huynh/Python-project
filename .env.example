# Copy to .env and fill in. Production = DEBUG=False (the default when unset).

# --- Core --------------------------------------------------------------------
DEBUG=True
# Production: a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Production: your API domain(s), comma-separated. In DEBUG, empty = any host.
ALLOWED_HOSTS=
# Production, for /admin over HTTPS: https://api.example.com
CSRF_TRUSTED_ORIGINS=
# Browser origins allowed to call the API (the web build of the app). In DEBUG, empty = all.
CORS_ALLOWED_ORIGINS=
# Number of reverse proxies in front of Django (for client IPs in rate limiting).
NUM_PROXIES=0
# Set False only if TLS is NOT terminated by your proxy (default True when DEBUG=False).
# SECURE_SSL_REDIRECT=True

# --- Database: PostgreSQL ----------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/django_db
# Host port for docker compose Postgres (change if 5432 is taken, and update DATABASE_URL)
POSTGRES_PORT=5432
# USE_SQLITE=True for quick local / single-container work without Postgres
USE_SQLITE=False
# Optional SQLite file path (Dockerfile sets SQLITE_PATH=/data/db.sqlite3 on the /data volume)
# SQLITE_PATH=db.sqlite3

# --- Redis: required in production --------------------------------------------
# Shared cache (rate limits, geocoding) + WebSocket events between web and worker processes.
# Without it everything must run in ONE process (the dispatcher then runs inside the web server).
REDIS_URL=redis://localhost:6379/0

# --- Maps --------------------------------------------------------------------
# Geoapify key (routing + place search): https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# --- SMS (OTP) ---------------------------------------------------------------
# Dotted path to a class implementing accounts.sms.BaseSMSBackend for your provider.
# The console backend only logs codes: OK for development, NOT for production.
SMS_BACKEND=accounts.sms.ConsoleBackend

# --- Dispatch (defaults shown) -----------------------------------------------
# DRIVER_SEARCH_RADIUS_KM=5
# DRIVER_LOCATION_MAX_AGE_SECONDS=120
# DRIVER_OFFER_SECONDS=15
# DISPATCH_BATCH_SIZE=3
# RIDE_SEARCH_SECONDS=180
# DRIVER_ARRIVAL_RADIUS_M=300
# MAX_TRIP_KM=150
# New drivers need approval in /admin unless this is True
# DRIVER_AUTO_APPROVE=False

# --- Tokens ------------------------------------------------------------------
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
