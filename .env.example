DEBUG=True
SECRET_KEY=django-insecure-3#_8c-92kt*32hu)=@^*6gh7#(-&rz6(#vi7rkxo=$pd9=+pue
ALLOWED_HOSTS=*

# Database: PostgreSQL
# Option 1: Full DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/django_db

# Option 2: Individual parameters (fallback if DATABASE_URL is unset)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=django_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set USE_SQLITE=True if you need to develop offline without PostgreSQL running
USE_SQLITE=False

# Host port for docker compose Postgres (change if 5432 is taken, and update DATABASE_URL / DB_PORT)
POSTGRES_PORT=5432

# Geoapify routing API key (free: https://myprojects.geoapify.com). Empty = straight-line fallback routes.
GEOAPIFY_API_KEY=

# Drivers within this radius (km) of the pickup receive the ride request
DRIVER_SEARCH_RADIUS_KM=5
# Auto-approve new drivers (set False to approve them in /admin)
DRIVER_AUTO_APPROVE=True

# Optional: Redis channel layer for WebSockets when running several server processes
# REDIS_URL=redis://localhost:6379/0
